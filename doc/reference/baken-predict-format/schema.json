{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/betashort/KEIBA_BLOG/doc/predict-output/schema.json",
  "title": "Keiba predict output",
  "description": "別プロジェクトが出力する開催日単位のレース予想 YAML（schema version 1）",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "date", "meetings"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "date": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "meetings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/meeting"
      }
    }
  },
  "definitions": {
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["venue", "races"],
      "properties": {
        "venue": {
          "type": "string",
          "minLength": 1
        },
        "races": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/race"
          }
        }
      }
    },
    "race": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "className",
        "name",
        "course",
        "runners",
        "horses",
        "marks",
        "bets"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "course": {
          "type": "string",
          "minLength": 1
        },
        "runners": {
          "type": "integer",
          "minimum": 1
        },
        "horses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/horse"
          }
        },
        "marks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "◎": { "type": "string", "minLength": 1 },
            "〇": { "type": "string", "minLength": 1 },
            "▲": { "type": "string", "minLength": 1 },
            "★": { "type": "string", "minLength": 1 },
            "△": { "type": "string", "minLength": 1 }
          }
        },
        "bets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "horse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "name", "finishRank", "placeProb"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "finishRank": {
          "type": "integer",
          "minimum": 1
        },
        "placeProb": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
